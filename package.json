{
  "name": "dev-command-center",
  "version": "0.1.0",
  "private": true,
  "main": ".electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:compile": "tsc -p electron/tsconfig.json && mkdir -p .electron/lib/database && cp lib/database/schema.sql .electron/lib/database/",
    "electron:dev": "yarn electron:compile && concurrently \"yarn dev\" \"wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
    "electron:start": "yarn electron:compile && electron .",
    "electron:build": "yarn electron:compile && yarn build && electron-builder",
    "electron:rebuild": "npx @electron/rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint ."
  },
  "dependencies": {
