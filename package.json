    "test:mcp:release-local": "bash scripts/validate-mcp-release-local.sh",
    "test:remote:e2e": "node scripts/e2e-remote.mjs",
    "preinstall": "node scripts/check-node-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.126"
  }
