{
  "name": "dev-command-center",
  "version": "0.3.1",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "native:local": "node scripts/native-local.mjs install",
    "native:rollback": "node scripts/native-local.mjs rollback",
