# Dev Command Center — variáveis locais (não commitadas)
#
# Uso rápido:
#   cp .env.example .env
#   # ou, em um git worktree: yarn setup-worktree
#
# No Vite, só variáveis com prefixo VITE_ chegam ao código do browser.
# Exemplo para uso futuro:
# VITE_SOME_FLAG=

# A maioria dos fluxos usa SQLite local; deixe comentado até precisar de integração.
