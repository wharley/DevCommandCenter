{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dev Command Center",
  "version": "0.1.1",
  "identifier": "com.devcommandcenter.app",
  "build": {
    "beforeDevCommand": "node scripts/build-sidecars.mjs --dev && node scripts/ensure-node.mjs && yarn vite",
    "beforeBuildCommand": "node scripts/build-sidecars.mjs && yarn vite:build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Dev Command Center",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4QTA3NDg0NEY0MDQ4RDkKUldUWlNFQlBoSFNnZU5DUEZkMW1lcE8xYTlZcXArYWlua3p0dHB5WU91aXpoQjBSTFk4My80Wk4K",
      "endpoints": [
        "https://httpbin.org/status/204"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "target/release/dcc",
      "target/release/dccd",
      "../sidecar/dist/dcc-claude-sidecar"
    ],
    "resources": {
      "../sidecar/dist/vendor/": "vendor"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
