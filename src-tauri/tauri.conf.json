{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dev Command Center",
  "version": "0.1.13",
  "identifier": "com.devcommandcenter.app",
  "build": {
    "beforeDevCommand": "node scripts/build-sidecars.mjs --dev && node scripts/ensure-node.mjs && yarn vite",
    "beforeBuildCommand": "yarn workspace @dcc/mobile-web build && node scripts/build-sidecars.mjs && yarn vite:build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Dev Command Center",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5RDRDNzU2MjJBM0REREMKUldUYzNhTWlWc2ZVbVRqZC9GSzZBeU9TbFlBTVNOcE5oenhtZVdZUDNaeDlEaFdrNEJmUWRTdVcK",
      "endpoints": [
        "https://github.com/wharley/DevCommandCenter/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [
      "target/release/dcc",
      "target/release/dccd",
      "target/release/dccd-http",
      "../sidecar/dist/dcc-claude-sidecar"
    ],
    "resources": {
      "../sidecar/dist/vendor/": "vendor",
      "../apps/mobile-web/dist/": "mobile-web"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
