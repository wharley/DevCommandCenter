{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "Cargo.toml",
    "package.json",
    "tsconfig.base.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        "target/**"
      ]
    },
    "build:contracts": {
      "outputs": [
        "packages/contracts/src/generated/**"
      ]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    }
  }
}
